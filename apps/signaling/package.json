{
  "name": "@round/signaling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native WebSocket signaling server for ROUND rooms.",
  "main": "dist/main.js",
  "scripts": {
    "predev": "npm run build -w @round/protocol",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@round/protocol": "*",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "22.15.32",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  }
}
