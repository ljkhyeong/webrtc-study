# .env.baton.local로 복사합니다. npm run build:baton과 build:web:baton이 읽습니다.
# BATON 인증 모드와 동일 출처 API 경로는 빌드 명령이 고정합니다.
# 이 파일에는 브라우저 공개 설정만 넣고 비밀키·API 토큰은 넣지 않습니다.
VITE_STUN_URLS=stun:stun.cloudflare.com:3478
VITE_ICE_TRANSPORT_POLICY=all
# Grafana Free 플랜을 확인한 뒤 브라우저용 수집 URL만 넣습니다. 기본은 전송하지 않습니다.
VITE_FARO_COLLECTOR_URL=
