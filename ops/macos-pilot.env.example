# Copy to ops/macos-pilot.env, keep mode 0600, and replace every blank value.
# This file is only for a temporary standalone study pilot on Docker Desktop.
COMPOSE_PROJECT_NAME=round-macos-pilot

# Local image tags built from the current checkout.
ROUND_EDGE_IMAGE=round-edge:macos-pilot
ROUND_SIGNALING_IMAGE=round-signaling:macos-pilot
ROUND_TURN_IMAGE=round-turn:macos-pilot

# Public HTTPS/WSS endpoint.
ROUND_DOMAIN=round.b4ton.com
ACME_EMAIL=
ALLOWED_ORIGINS=https://round.b4ton.com
ROUND_ACCESS_USER=round-study
# Keep the bcrypt cost-12 hash in single quotes so Compose does not expand '$'.
ROUND_ACCESS_PASSWORD_HASH=''
ROUND_STANDALONE_HOST_TOKEN_SHA256=

MAX_ROOM_SIZE=6
MAX_SIGNALING_CONNECTIONS=1000
MAX_SIGNALING_CONNECTIONS_PER_CLIENT=12
HEARTBEAT_INTERVAL_MS=30000
SIGNALING_ABUSE_WINDOW_MS=10000
SIGNALING_MAX_FRAMES_PER_SESSION=600
SIGNALING_MAX_FRAMES_PER_CLIENT=1200
SIGNALING_MAX_FRAMES_GLOBAL=3600

VITE_STUN_URLS=stun:turn.b4ton.com:3478
VITE_ICE_TRANSPORT_POLICY=all
TURN_URLS=turn:turn.b4ton.com:3478?transport=udp,turn:turn.b4ton.com:3478?transport=tcp,turns:turn.b4ton.com:5349?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=600
TURN_CREDENTIAL_RATE_LIMIT_WINDOW_SECONDS=600
TURN_CREDENTIAL_RATE_LIMIT_MAX_REQUESTS=12
TURN_CREDENTIAL_RATE_LIMIT_GLOBAL_MAX_REQUESTS=24
TURN_CREDENTIAL_RATE_LIMIT_MAX_CLIENTS=10000

# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=

# Public IPv4 from the b4ton.com DNS records. The relay IP is the fixed Docker
# bridge address declared by compose.macos-pilot.yml, not the Mac's LAN address.
TURN_EXTERNAL_IP=
TURN_RELAY_IP=172.31.0.10
TURN_REALM=turn.b4ton.com
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
TURN_USER_QUOTA=20
TURN_TOTAL_QUOTA=100
TURN_MAX_BPS=2000000
TURN_BPS_CAPACITY=30000000
TURN_CONTAINER_IP=172.31.0.10
TURN_CONTAINER_SUBNET=172.31.0.0/24

# Router-facing 80/443 are forwarded to these alternate Mac host ports.
ROUND_HTTP_BIND_PORT=8080
ROUND_HTTPS_BIND_PORT=8443

# A publicly trusted certificate whose SAN covers turn.b4ton.com.
TURN_TLS_CERT_FILE=./ops/certs/fullchain.pem
TURN_TLS_KEY_FILE=./ops/certs/privkey.pem
