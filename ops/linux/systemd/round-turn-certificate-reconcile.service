[Unit]
Description=coturn이 불러온 TURN 인증서 조정 및 검증
Documentation=file:/opt/round/docs/deployment.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
OnFailure=round-ops-failure@%n.service
StartLimitIntervalSec=30m
StartLimitBurst=3
AssertPathExists=/opt/round/ops/linux/reload-turn-certificate.sh
AssertPathExists=/etc/round/production.env
AssertPathExists=/var/lib/round/releases/current.env

[Service]
Type=oneshot
StateDirectory=round/certificates
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
Restart=on-failure
RestartSec=5m
TimeoutStartSec=180s
ExecStart=/bin/bash /opt/round/ops/linux/reload-turn-certificate.sh --release-state-dir /var/lib/round/releases --certificate-state-dir /var/lib/round/certificates --check-host 127.0.0.1 --check-port 5349 /etc/round/production.env
