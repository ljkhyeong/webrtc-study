#!/usr/bin/env bash
set -Eeuo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=ops/linux/common.sh
source "$script_dir/../common.sh"
umask 077

env_file=${ROUND_ENV_FILE:-/etc/round/production.env}
state_dir=${ROUND_CERTIFICATE_STATE_DIR:-/var/lib/round/certificates}
check_host=${ROUND_TURN_CERTIFICATE_CHECK_HOST:-127.0.0.1}
check_port=${ROUND_TURN_CERTIFICATE_CHECK_PORT:-5349}
minimum_validity_seconds=${ROUND_TURN_CERTIFICATE_MINIMUM_VALIDITY_SECONDS:-604800}
tls_ca_file=${ROUND_TURN_CERTIFICATE_CHECK_CA_FILE:-}

[[ "$env_file" == /* ]] || round_ops_die 'ROUND_ENV_FILE must be an absolute path'
[[ "$state_dir" == /* && "$state_dir" != / ]] ||
  round_ops_die 'ROUND_CERTIFICATE_STATE_DIR must be an absolute non-root path'
[[ "$check_host" =~ ^[A-Za-z0-9.-]+$ ]] ||
  round_ops_die 'ROUND_TURN_CERTIFICATE_CHECK_HOST must be an IPv4 address or DNS hostname'
if [[ ! "$check_port" =~ ^[1-9][0-9]*$ ]] || (( check_port > 65535 )); then
  round_ops_die 'ROUND_TURN_CERTIFICATE_CHECK_PORT must be between 1 and 65535'
fi
[[ "$minimum_validity_seconds" =~ ^[1-9][0-9]*$ ]] ||
  round_ops_die 'ROUND_TURN_CERTIFICATE_MINIMUM_VALIDITY_SECONDS must be a positive integer'

round_ops_require_command openssl
round_ops_require_command timeout
round_ops_require_private_file "$env_file"
round_ops_validate_certificate "$env_file" "$minimum_validity_seconds"

round_ops_require_private_directory "$state_dir"
fingerprint_file=$state_dir/turn-certificate.sha256
round_ops_require_private_file "$fingerprint_file"

expected_fingerprint=$(round_ops_turn_certificate_fingerprint "$env_file")

recorded_fingerprint=$(<"$fingerprint_file")
[[ "$recorded_fingerprint" =~ ^([0-9A-F]{2}:){31}[0-9A-F]{2}$ ]] ||
  round_ops_die 'loaded TURN certificate fingerprint state is malformed'
[[ "$recorded_fingerprint" == "$expected_fingerprint" ]] ||
  round_ops_die 'configured TURN certificate has not been applied by the deploy hook'

round_ops_verify_turn_tls_listener \
  "$env_file" "$check_host" "$check_port" "$tls_ca_file" \
  >/dev/null

printf 'TURN certificate state and coturn TLS listener verification passed.\n'
