# ops/production.env로 복사하고 mode 0600을 유지한 뒤 모든 예시 값을 교체합니다.
# 이 예시와 compose.yml은 공유 비밀번호 방식의 standalone 파일럿 전용입니다.
# compose.yml은 ROUND_AUTH_MODE=standalone을 고정하므로 환경 override로 이 Caddy routing
# 계약을 BATON 모드로 조용히 전환할 수 없습니다. docs/deployment.md에 설명된 별도의 BATON
# 배포 manifest를 사용하고, 이 파일에는 BATON issuer 또는 JWK 설정을 추가하지 않습니다.
COMPOSE_PROJECT_NAME=round

# 불변 배포 이미지 이름입니다. production 전에 이 release tag를 release-images workflow가
# 출력한 registry digest로 교체합니다.
ROUND_EDGE_IMAGE=ghcr.io/ljkhyeong/round-edge:v0.1.0-rc.1
ROUND_SIGNALING_IMAGE=ghcr.io/ljkhyeong/round-signaling:v0.1.0-rc.1
ROUND_TURN_IMAGE=ghcr.io/ljkhyeong/round-turn:v0.1.0-rc.1

# Caddy HTTPS/WSS endpoint입니다.
ROUND_DOMAIN=round.example.com
ACME_EMAIL=admin@example.com
ALLOWED_ORIGINS=https://round.example.com
# 임시 공유 파일럿 접근 gate입니다. ':'가 없는 단순한 username을 선택합니다.
ROUND_ACCESS_USER=round-study
# 평문 비밀번호를 shell history에 남기지 않는 생성 명령:
#   docker run --rm -it caddy:2.11.4-alpine \
#     caddy hash-password --algorithm bcrypt --bcrypt-cost 12
# 생성된 bcrypt cost-12 hash만 여기에 붙여 넣습니다. 평문 비밀번호를 이 파일, Git,
# 이미지 또는 배포 log에 저장하지 않습니다. Compose가 hash의 달러 기호를 보간하지 않도록
# 작은따옴표를 유지합니다.
ROUND_ACCESS_PASSWORD_HASH=''

# standalone 파일럿의 선택적인 방장 권한입니다. 최소 32바이트의 무작위 값을 생성하고
# (`openssl rand -hex 32`는 64자의 key 생성), 평문은 방장만 공유하는 password manager에
# 보관하며 소문자 SHA-256 digest만 여기에 저장합니다. 사이트 전체 Basic Auth 비밀번호와는
# 다릅니다. 저장한 key를 shell history에 남기지 않고 hash합니다(prompt 입력은 숨김):
#   read -r -s 'ROUND_HOST_KEY?Standalone host key: '
#   printf '\n'
#   printf '%s' "$ROUND_HOST_KEY" | shasum -a 256
#   unset ROUND_HOST_KEY
# 하나의 digest가 이 서버의 모든 standalone 방에 방장 권한을 부여합니다. 유출되면 즉시
# 회전하고, 방장 권한을 비활성화하려면 비워 둡니다.
ROUND_STANDALONE_HOST_TOKEN_SHA256=

# Signaling runtime입니다. ROUND_AUTH_MODE는 의도적으로 여기서 설정할 수 없습니다.
MAX_ROOM_SIZE=6
MAX_SIGNALING_CONNECTIONS=1000
MAX_SIGNALING_CONNECTIONS_PER_CLIENT=12
HEARTBEAT_INTERVAL_MS=30000
SIGNALING_ABUSE_WINDOW_MS=10000
SIGNALING_MAX_FRAMES_PER_SESSION=600
SIGNALING_MAX_FRAMES_PER_CLIENT=1200
SIGNALING_MAX_FRAMES_GLOBAL=3600

# 브라우저 STUN은 정적 web 이미지에 포함됩니다. TURN credential은 runtime에
# /api/turn-credentials에서 가져옵니다.
VITE_STUN_URLS=stun:turn.example.com:3478
# 전용 TURN 경로 검증 이미지에서만 "relay"를 사용합니다.
VITE_ICE_TRANSPORT_POLICY=all
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=600
TURN_CREDENTIAL_RATE_LIMIT_WINDOW_SECONDS=600
TURN_CREDENTIAL_RATE_LIMIT_MAX_REQUESTS=12
TURN_CREDENTIAL_RATE_LIMIT_GLOBAL_MAX_REQUESTS=24
TURN_CREDENTIAL_RATE_LIMIT_MAX_CLIENTS=10000

# 생성 명령: openssl rand -hex 32
# 이 값은 runtime의 signaling과 coturn만 공유합니다. 절대 commit하지 않습니다.
TURN_SHARED_SECRET=

# Coturn host-network 주소입니다. host가 공개 IPv4를 직접 소유하면 같은 주소를 사용하고,
# NAT 뒤에서는 RELAY_IP에 host의 private interface를 사용합니다.
TURN_EXTERNAL_IP=203.0.113.10
TURN_RELAY_IP=203.0.113.10
TURN_REALM=turn.example.com
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
TURN_USER_QUOTA=20
TURN_TOTAL_QUOTA=100
TURN_MAX_BPS=2000000
TURN_BPS_CAPACITY=30000000

# SAN이 TURN_REALM을 포함하는 인증서입니다. 이 파일들은 host에만 둡니다.
TURN_TLS_CERT_FILE=./ops/certs/fullchain.pem
TURN_TLS_KEY_FILE=./ops/certs/privkey.pem

# 선택적인 base 이미지 override입니다. 강화된 release에서는 registry digest로 고정합니다.
# NODE_IMAGE=node:22.23.0-alpine3.24
# CADDY_BUILDER_IMAGE=caddy:2.11.4-builder-alpine
# CADDY_IMAGE=caddy:2.11.4-alpine
# JAVA_BUILD_IMAGE=eclipse-temurin:21.0.11_10-jdk-alpine-3.23
# JAVA_RUNTIME_IMAGE=eclipse-temurin:21.0.11_10-jre-alpine-3.23
# COTURN_IMAGE=coturn/coturn:4.14.0-r0-alpine
