# Copy to ops/production.env, keep mode 0600, and replace every example value.
COMPOSE_PROJECT_NAME=round

# Immutable deployment image names. Replace these release tags with the
# registry digests printed by the release-images workflow before production.
ROUND_EDGE_IMAGE=ghcr.io/ljkhyeong/round-edge:v0.1.0-rc.1
ROUND_SIGNALING_IMAGE=ghcr.io/ljkhyeong/round-signaling:v0.1.0-rc.1
ROUND_TURN_IMAGE=ghcr.io/ljkhyeong/round-turn:v0.1.0-rc.1

# Caddy HTTPS/WSS endpoint.
ROUND_DOMAIN=round.example.com
ACME_EMAIL=admin@example.com
ALLOWED_ORIGINS=https://round.example.com

# Signaling runtime.
MAX_ROOM_SIZE=6
HEARTBEAT_INTERVAL_MS=30000

# Browser STUN is compiled into the static web image. TURN credentials are
# fetched at runtime from /api/turn-credentials.
VITE_STUN_URLS=stun:turn.example.com:3478
# Use "relay" only for a dedicated TURN-path validation image.
VITE_ICE_TRANSPORT_POLICY=all
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=600
TURN_CREDENTIAL_RATE_LIMIT_WINDOW_SECONDS=60
TURN_CREDENTIAL_RATE_LIMIT_MAX_REQUESTS=12
TURN_CREDENTIAL_RATE_LIMIT_GLOBAL_MAX_REQUESTS=8
TURN_CREDENTIAL_RATE_LIMIT_MAX_CLIENTS=10000

# Generate with: openssl rand -hex 32
# This value is shared only by signaling and coturn at runtime. Never commit it.
TURN_SHARED_SECRET=

# Coturn host-network addresses. Use the same address when the host owns the
# public IPv4 directly; behind NAT, RELAY_IP is the host's private interface.
TURN_EXTERNAL_IP=203.0.113.10
TURN_RELAY_IP=203.0.113.10
TURN_REALM=turn.example.com
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
TURN_USER_QUOTA=12
TURN_TOTAL_QUOTA=120
TURN_MAX_BPS=2000000
TURN_BPS_CAPACITY=30000000

# A certificate whose SAN covers TURN_REALM. These files stay on the host.
TURN_TLS_CERT_FILE=./ops/certs/fullchain.pem
TURN_TLS_KEY_FILE=./ops/certs/privkey.pem

# Optional base-image overrides. Pin registry digests in a hardened release.
# NODE_IMAGE=node:22.23.0-alpine3.24
# CADDY_IMAGE=caddy:2.10.2-alpine
# JAVA_BUILD_IMAGE=eclipse-temurin:21.0.10_7-jdk-alpine-3.22
# JAVA_RUNTIME_IMAGE=eclipse-temurin:21.0.10_7-jre-alpine-3.22
# COTURN_IMAGE=coturn/coturn:4.14.0-r0-alpine
