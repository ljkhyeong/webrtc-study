# macOS 스터디 파일럿 edge 정책입니다.
#
# 모바일 브라우저는 페이지의 HTTP Basic Auth credential을 WebSocket upgrade에 일관되게
# 재사용하지 않습니다. UI와 정적 asset은 공유 파일럿 비밀번호 뒤에 두고, 두 브라우저
# transport endpoint는 signaling 서비스의 exact-origin 검사와 제한된 connection, frame,
# byte 및 TURN credential quota를 사용합니다. 이 파일을 Linux production edge 계약으로
# 사용하지 않습니다.
{
	email {$ACME_EMAIL}
	admin off
	log default {
		output stdout
		format filter {
			request>headers delete
			request>uri delete
			remote_ip hash
			wrap json
		}
	}
}

http://127.0.0.1:8080 {
	handle /healthz {
		reverse_proxy signaling:8787 {
			header_up -Authorization
		}
	}

	respond 404
}

{$ROUND_DOMAIN} {
	encode zstd gzip

	# 모바일 호환 transport 경로는 의도적으로 거친 공유 Basic Auth gate만 우회합니다.
	# 애플리케이션 계층의 origin 및 quota 검사는 signaling에서 계속 적용됩니다.
	@requiresPilotAccess not path /healthz /signal /api/turn-credentials
	rate_limit {
		zone pilot_client {
			match {
				not path /healthz
				header Authorization *
			}
			key {remote_host}
			events 96
			window 5m
			ipv6_prefix 64
		}
		sweep_interval 1m
	}
	basic_auth @requiresPilotAccess bcrypt {
		{$ROUND_ACCESS_USER} {$ROUND_ACCESS_PASSWORD_HASH}
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://{$ROUND_DOMAIN}; form-action 'self'"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	handle /signal {
		reverse_proxy signaling:8787 {
			header_up -Authorization
		}
	}

	handle /api/turn-credentials {
		reverse_proxy signaling:8787 {
			header_up -Authorization
		}
	}

	handle /healthz {
		reverse_proxy signaling:8787 {
			header_up -Authorization
		}
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format filter {
			request>headers delete
			request>uri delete
			request>remote_ip hash
			request>client_ip hash
			wrap json
		}
	}
}
