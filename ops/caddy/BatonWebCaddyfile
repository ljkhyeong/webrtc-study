{
	admin off
	auto_https off
	log default {
		output stdout
		format filter {
			request>headers delete
			request>uri delete
			request>remote_ip hash
			request>client_ip hash
			wrap json
		}
	}
}

:8080 {
	header {
		-Server
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	handle /healthz {
		header Cache-Control "no-store"
		respond "OK" 200
	}

	handle /round-ui/assets/* {
		uri strip_prefix /round-ui
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /round-ui/favicon.svg {
		uri strip_prefix /round-ui
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	handle /round-ui/* {
		header Cache-Control "no-store"
		respond "Open ROUND from an authorized BATON study room." 404
	}

	handle /room/* {
		root * /srv
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}

	respond 404
}
