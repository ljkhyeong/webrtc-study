{
	admin off
	auto_https off
	log default {
		output stdout
		format filter {
			request>headers delete
			request>uri delete
			request>remote_ip hash
			request>client_ip hash
			wrap json
		}
	}
}

:8080 {
	header {
		-Server
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	handle /healthz {
		header Cache-Control "no-store"
		respond "OK" 200
	}

	handle /round-ui/assets/* {
		route {
			uri strip_prefix /round-ui
			root * /srv

			@immutable_vite_asset {
				path_regexp vite_asset ^/assets/(?:[^/]+/)*[^/]+-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9.]+$
				file
			}
			header @immutable_vite_asset Cache-Control "public, max-age=31536000, immutable"
			file_server @immutable_vite_asset

			header Cache-Control "no-store"
			respond 404
		}
	}

	handle /round-ui/favicon.svg {
		uri strip_prefix /round-ui
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	handle /round-ui/* {
		header Cache-Control "no-store"
		respond "권한이 있는 BATON 스터디룸에서 ROUND를 여세요." 404
	}

	handle /room/* {
		root * /srv
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}

	respond 404
}
