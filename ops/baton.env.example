# ROUND 시그널링 프로세스에 전달할 환경변수입니다. 운영 배포를 실행하지 않습니다.
# 비밀값을 채운 파일은 Git 밖에 보관합니다. 웹 빌드 환경과 구분합니다.
SPRING_PROFILES_ACTIVE=production
ROUND_AUTH_MODE=baton
ROUND_AUTH_ISSUER=https://b4ton.com
ROUND_AUTH_AUDIENCE=round
ROUND_AUTH_JWK_SET_URI=https://b4ton.com/.well-known/round-participation-jwks.json
ROUND_AUTH_COOKIE_NAME=__Secure-round_access
ROUND_AUTH_MAX_GRANT_LIFETIME_SECONDS=300
ALLOWED_ORIGINS=https://b4ton.com
HOST=0.0.0.0
PORT=8787

TURN_PROVIDER=coturn
TURN_COTURN_URLS=turn:turn.b4ton.com:3478?transport=udp,turn:turn.b4ton.com:3478?transport=tcp,turns:turn.b4ton.com:5349?transport=tcp
# coturn static-auth-secret과 같은 32자 이상의 무작위 값. 빈 상태로는 시작에 실패합니다.
TURN_COTURN_SECRET=

# Secret 파일을 사용하면 위 TURN_COTURN_SECRET 줄을 제거하고 아래 import를 설정합니다.
# /run/secrets/round.turn.coturn-secret 파일에 비밀값만 넣습니다.
# SPRING_CONFIG_IMPORT=configtree:/run/secrets/
# 기존 BATON의 TURN_URLS와 round.turn.shared-secret 파일도 production 프로필에서 지원합니다.
