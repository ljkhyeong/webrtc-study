# Browser-facing WebSocket endpoint. Leave empty in local development to use the Vite proxy.
VITE_SIGNALING_URL=

# Comma-separated STUN URLs. Add TURN credentials before using the app across restrictive networks.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Signaling server
PORT=8787
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173
MAX_ROOM_SIZE=6
HEARTBEAT_INTERVAL_MS=30000
