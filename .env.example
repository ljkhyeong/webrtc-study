# 브라우저 endpoint 모드는 Vite bundle에 포함됩니다. 기본 제공 stack은 standalone입니다.
# BATON 소유 web build는 이 값을 baton으로 설정하고 두 endpoint override를 모두 비워
# 방 범위 same-origin 경로를 강제합니다.
VITE_ROUND_AUTH_MODE=standalone

# standalone 전용 브라우저 WebSocket endpoint입니다. 로컬과 same-origin standalone
# 배포에서는 현재 host의 /signal을 사용하도록 비워 둡니다.
VITE_SIGNALING_URL=

# 브라우저 ICE 설정입니다. TURN credential은 runtime에 가져오며 Vite bundle에 포함하지
# 않습니다. release candidate TURN 테스트에서만 정책을 relay로 설정합니다.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# standalone 전용 override입니다. BATON web build는 정규 방 범위 경로를 사용합니다.
VITE_TURN_CREDENTIALS_URL=
VITE_ICE_TRANSPORT_POLICY=all

# Signaling 서버
PORT=8787
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ROOM_SIZE=6
MAX_SIGNALING_CONNECTIONS=1000
MAX_SIGNALING_CONNECTIONS_PER_CLIENT=12
HEARTBEAT_INTERVAL_MS=30000
UNJOINED_SOCKET_TIMEOUT_MS=15000
UNJOINED_SOCKET_SWEEP_MS=1000
SIGNALING_SHUTDOWN_CLOSE_TIMEOUT_MS=5000
SIGNALING_ABUSE_WINDOW_MS=10000
SIGNALING_MAX_FRAMES_PER_SESSION=600
SIGNALING_MAX_FRAMES_PER_CLIENT=1200
SIGNALING_MAX_FRAMES_GLOBAL=3600
SIGNALING_MAX_BYTES_PER_SESSION=4194304
SIGNALING_MAX_BYTES_PER_CLIENT=8388608
SIGNALING_MAX_BYTES_GLOBAL=25165824
SIGNALING_MAX_OUTBOUND_QUEUE_BYTES=2097152
SIGNALING_MAX_OUTBOUND_QUEUE_BYTES_GLOBAL=67108864

# 인증 경계입니다. 로컬 개발과 기본 제공 production Compose는 standalone 모드로
# 실행됩니다. BATON 소유 배포 manifest는 ROUND_AUTH_MODE=baton을 설정하고 아래의 모든
# verifier 값을 제공해야 하며, 비공개 서명 key를 ROUND에 넣으면 안 됩니다.
ROUND_AUTH_MODE=standalone
ROUND_AUTH_COOKIE_NAME=__Secure-round_access
ROUND_AUTH_ISSUER=
ROUND_AUTH_AUDIENCE=round
ROUND_AUTH_JWK_SET_URI=
ROUND_AUTH_MAX_GRANT_LIFETIME_SECONDS=300
# standalone 전용입니다. 여기에 SHA-256 hex digest를 저장하고, 방장은 최소 32자의 원본
# 무작위 secret을 입력합니다. 하나의 digest가 이 서버의 모든 방에 적용되므로 유출되면
# 즉시 회전합니다. 비활성화하려면 비워 둡니다.
ROUND_STANDALONE_HOST_TOKEN_SHA256=

# 선택적인 로컬 coturn REST credential입니다. 로컬 개발에서 endpoint를 비활성화하려면
# 두 값을 모두 비워 둡니다. production에서는 ops/production.env를 사용합니다.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600
TURN_CREDENTIAL_RATE_LIMIT_WINDOW_SECONDS=600
TURN_CREDENTIAL_RATE_LIMIT_MAX_REQUESTS=12
TURN_CREDENTIAL_RATE_LIMIT_PARTICIPANT_MAX_REQUESTS=6
TURN_CREDENTIAL_RATE_LIMIT_GLOBAL_MAX_REQUESTS=24
TURN_CREDENTIAL_RATE_LIMIT_MAX_CLIENTS=10000
TURN_CREDENTIAL_RATE_LIMIT_MAX_PARTICIPANTS=10000
