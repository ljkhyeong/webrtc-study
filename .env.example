# Browser-facing WebSocket endpoint. Leave empty locally and in same-origin
# production deployments to use /signal on the current host.
VITE_SIGNALING_URL=

# Browser ICE configuration. TURN credentials are fetched at runtime and are
# never compiled into the Vite bundle. Set policy to relay only for the
# release-candidate TURN test.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_TURN_CREDENTIALS_URL=/api/turn-credentials
VITE_ICE_TRANSPORT_POLICY=all

# Signaling server
PORT=8787
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ROOM_SIZE=6
MAX_SIGNALING_CONNECTIONS=1000
MAX_SIGNALING_CONNECTIONS_PER_CLIENT=12
HEARTBEAT_INTERVAL_MS=30000
UNJOINED_SOCKET_TIMEOUT_MS=15000
UNJOINED_SOCKET_SWEEP_MS=1000
SIGNALING_SHUTDOWN_CLOSE_TIMEOUT_MS=5000
SIGNALING_ABUSE_WINDOW_MS=10000
SIGNALING_MAX_FRAMES_PER_SESSION=600
SIGNALING_MAX_FRAMES_PER_CLIENT=1200
SIGNALING_MAX_FRAMES_GLOBAL=3600
SIGNALING_MAX_BYTES_PER_SESSION=4194304
SIGNALING_MAX_BYTES_PER_CLIENT=8388608
SIGNALING_MAX_BYTES_GLOBAL=25165824
SIGNALING_MAX_OUTBOUND_QUEUE_BYTES=2097152
SIGNALING_MAX_OUTBOUND_QUEUE_BYTES_GLOBAL=67108864

# Optional local coturn REST credentials. Leave both values empty to disable
# the endpoint in local development. In production, use ops/production.env.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600
TURN_CREDENTIAL_RATE_LIMIT_WINDOW_SECONDS=600
TURN_CREDENTIAL_RATE_LIMIT_MAX_REQUESTS=12
TURN_CREDENTIAL_RATE_LIMIT_GLOBAL_MAX_REQUESTS=24
TURN_CREDENTIAL_RATE_LIMIT_MAX_CLIENTS=10000
